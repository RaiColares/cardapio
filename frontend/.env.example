# URL da API consumida pelo Axios. É embutida no bundle em build-time pelo
# Vite (variáveis precisam do prefixo VITE_). Em produção na Vercel, defina
# no painel do projeto — ex.: https://<backend>/api/v1
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Origem do servidor realtime (Socket.IO anexado ao HTTP principal da API).
# Não inclui o sufixo /api/v1. Em produção: https://<backend>
VITE_SOCKET_URL=http://localhost:4000
