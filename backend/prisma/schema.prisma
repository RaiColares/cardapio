// Prisma schema — Cardápio Digital para Balneários
//
// Banco: PostgreSQL
// Convenções:
//   - UUIDs como chaves primárias
//   - Multi-tenancy via establishmentId (escopo de isolamento)
//   - Snapshots históricos em OrderItem / OrderItemModifier
//   - Valores monetários em Decimal (evita erro de precisão de ponto flutuante)
//   - Tabelas no plural, snake_case

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums
// ============================================================

enum EstablishmentStatus {
  ACTIVE
  INACTIVE
}

enum UserRole {
  ADMIN
  MANAGER
  WAITER
  KITCHEN
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  NEW_ORDER
  PREPARING
  READY
  BILL_REQUESTED
}

enum TableSessionStatus {
  OPEN
  CLOSED
}

enum SelectionType {
  SINGLE
  MULTIPLE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
  SPECIAL_PRICE
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  PIX
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

// ============================================================
// Establishment
// ============================================================

model Establishment {
  id          String               @id @default(uuid())
  name        String
  slug        String               @unique
  logoUrl     String?
  bannerUrl   String?
  description String?
  phone       String?
  whatsapp    String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  status      EstablishmentStatus  @default(ACTIVE)
  // Taxa de serviço — configuração do estabelecimento (FASE 8)
  serviceFeeEnabled Boolean         @default(false) @map("service_fee_enabled")
  serviceFeeRate    Decimal         @default(0)     @map("service_fee_rate") @db.Decimal(5, 2)
  // FASE 24 — métodos de pagamento aceites pelo estabelecimento.
  // Usa String[] (e não enum[]) porque o Prisma não suporta listas de enum
  // no PostgreSQL; os valores espelham o enum PaymentMethod
  // (CASH | CREDIT_CARD | DEBIT_CARD | PIX) — crédito e débito são
  // independentes (FASE 24 refinamento).
  acceptedPaymentMethods String[]   @default(["CASH", "CREDIT_CARD", "DEBIT_CARD", "PIX"]) @map("accepted_payment_methods")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  users          User[]
  areas          Area[]
  tables         Table[]
  tableSessions  TableSession[]
  categories     Category[]
  products       Product[]
  modifierGroups ModifierGroup[]
  combos         Combo[]
  promotions     Promotion[]
  customers      Customer[]
  orders         Order[]

  @@map("establishments")
}

// ============================================================
// User
// ============================================================

model User {
  id              String   @id @default(uuid())
  establishmentId String   @map("establishment_id")
  name            String
  email           String   @unique
  passwordHash    String   @map("password_hash")
  role            UserRole @default(WAITER)
  phone           String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  auditLogs     AuditLog[]
  // FASE 23 — mesas vinculadas ao garçom (NxN). Define a visibilidade
  // da mesa/sala no salão quando há garçons atribuídos.
  tables        Table[]      @relation("TableWaiters")

  @@index([establishmentId])
  @@index([email])
  @@map("users")
}

// ============================================================
// Area
// ============================================================

model Area {
  id              String   @id @default(uuid())
  establishmentId String   @map("establishment_id")
  name            String
  description     String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  tables        Table[]

  @@index([establishmentId])
  @@map("areas")
}

// ============================================================
// Table
// ============================================================

model Table {
  id              String      @id @default(uuid())
  establishmentId String      @map("establishment_id")
  areaId          String      @map("area_id")
  number          String
  name            String?
  capacity        Int         @default(1)
  qrCode          String      @unique @map("qr_code")
  status          TableStatus @default(AVAILABLE)
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  area          Area          @relation(fields: [areaId], references: [id])
  tableSessions TableSession[]
  orders        Order[]
  // FASE 23 — garçons vinculados à mesa (NxN). Quando não vazio, somente
  // esses garçons (e MANAGER/ADMIN) enxergam a mesa e recebem os eventos.
  waiters       User[]        @relation("TableWaiters")

  @@unique([establishmentId, number])
  @@index([establishmentId])
  @@index([areaId])
  @@index([status])
  @@map("tables")
}

// ============================================================
// TableSession
// ============================================================

model TableSession {
  id                  String             @id @default(uuid())
  tableId             String             @map("table_id")
  establishmentId     String             @map("establishment_id")
  sessionToken        String             @unique @map("session_token")
  status              TableSessionStatus @default(OPEN)
  openedAt            DateTime           @default(now())
  closedAt            DateTime?
  paymentMethodIntent String?            @map("payment_method_intent")
  changeRequested     Decimal?           @db.Decimal(10, 2) @map("change_requested")
  // FASE 23 — ajustes manuais da comanda (aplicados no total a pagar).
  discountAmount      Decimal            @default(0) @db.Decimal(10, 2) @map("discount_amount")
  extraChargeAmount   Decimal            @default(0) @db.Decimal(10, 2) @map("extra_charge_amount")
  extraChargeNote     String?            @map("extra_charge_note")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  table         Table          @relation(fields: [tableId], references: [id])
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  orders        Order[]
  payments      Payment[]

  @@index([tableId])
  @@index([establishmentId])
  @@index([status])
  @@map("table_sessions")
}

// ============================================================
// Category
// ============================================================

model Category {
  id              String   @id @default(uuid())
  establishmentId String   @map("establishment_id")
  name            String
  description     String?
  imageUrl        String?
  icon            String?
  displayOrder    Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  products      Product[]

  @@unique([establishmentId, name])
  @@index([establishmentId])
  @@map("categories")
}

// ============================================================
// Product
// ============================================================

model Product {
  id               String   @id @default(uuid())
  establishmentId  String   @map("establishment_id")
  categoryId       String   @map("category_id")
  name             String
  description      String?
  imageUrl         String?
  price            Decimal  @db.Decimal(10, 2)
  promotionalPrice Decimal? @db.Decimal(10, 2)
  preparationTime  Int?
  ingredients      String?
  allergens        String?
  displayOrder     Int      @default(0)
  featured         Boolean  @default(false)
  active           Boolean  @default(true)
  available        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  establishment  Establishment          @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  category       Category               @relation(fields: [categoryId], references: [id])
  modifierGroups ProductModifierGroup[]
  orderItems     OrderItem[]

  @@index([establishmentId])
  @@index([categoryId])
  @@index([available])
  @@map("products")
}

// ============================================================
// ModifierGroup
// ============================================================

model ModifierGroup {
  id              String        @id @default(uuid())
  establishmentId String        @map("establishment_id")
  name            String
  selectionType   SelectionType @default(SINGLE)
  minSelections   Int           @default(0)
  maxSelections   Int?
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  establishment Establishment          @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  modifiers     Modifier[]
  products      ProductModifierGroup[]

  @@index([establishmentId])
  @@map("modifier_groups")
}

// ============================================================
// Modifier
// ============================================================

model Modifier {
  id              String   @id @default(uuid())
  modifierGroupId String   @map("modifier_group_id")
  name            String
  price           Decimal  @db.Decimal(10, 2)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  modifierGroup      ModifierGroup       @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  orderItemModifiers OrderItemModifier[]

  @@index([modifierGroupId])
  @@map("modifiers")
}

// ============================================================
// ProductModifierGroup (relação N:N entre Product e ModifierGroup)
// ============================================================

model ProductModifierGroup {
  id              String   @id @default(uuid())
  productId       String   @map("product_id")
  modifierGroupId String   @map("modifier_group_id")
  displayOrder    Int      @default(0)

  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@unique([productId, modifierGroupId])
  @@index([modifierGroupId])
  @@map("product_modifier_groups")
}

// ============================================================
// Combo
// ============================================================

model Combo {
  id              String   @id @default(uuid())
  establishmentId String   @map("establishment_id")
  name            String
  description     String?
  imageUrl        String?
  price           Decimal  @db.Decimal(10, 2)
  active          Boolean  @default(true)
  featured        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId])
  @@map("combos")
}

// ============================================================
// Promotion
// ============================================================

model Promotion {
  id              String       @id @default(uuid())
  establishmentId String       @map("establishment_id")
  name            String
  description     String?
  discountType    DiscountType @default(PERCENTAGE)
  discountValue   Decimal      @db.Decimal(10, 2)
  startDate       DateTime?
  endDate         DateTime?
  startTime       String?
  endTime         String?
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId])
  @@map("promotions")
}

// ============================================================
// Customer
// ============================================================

model Customer {
  id              String   @id @default(uuid())
  establishmentId String   @map("establishment_id")
  name            String?
  phone           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  orders        Order[]

  @@index([establishmentId])
  @@map("customers")
}

// ============================================================
// Order
// ============================================================

model Order {
  id              String      @id @default(uuid())
  establishmentId String      @map("establishment_id")
  tableId         String      @map("table_id")
  tableSessionId  String      @map("table_session_id")
  customerId      String?     @map("customer_id")
  orderNumber     Int         @map("order_number")
  status          OrderStatus @default(PENDING)
  subtotal        Decimal     @default(0) @db.Decimal(10, 2)
  discount        Decimal     @default(0) @db.Decimal(10, 2)
  serviceFee      Decimal     @default(0) @map("service_fee") @db.Decimal(10, 2)
  total           Decimal     @default(0) @db.Decimal(10, 2)
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  table         Table         @relation(fields: [tableId], references: [id])
  tableSession  TableSession  @relation(fields: [tableSessionId], references: [id])
  customer      Customer?     @relation(fields: [customerId], references: [id])
  items         OrderItem[]

  @@unique([establishmentId, orderNumber])
  @@index([establishmentId])
  @@index([tableId])
  @@index([tableSessionId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

// ============================================================
// OrderItem (com snapshots históricos)
// ============================================================

model OrderItem {
  id               String   @id @default(uuid())
  orderId          String   @map("order_id")
  productId        String   @map("product_id")
  // Snapshots históricos — não podem ser alterados por mudanças futuras no cadastro
  productName      String   @map("product_name")
  // Snapshot legado: o conceito de variações foi removido do domínio (Fase 23).
  // Mantido para preservar o histórico de pedidos anteriores à remoção;
  // novos pedidos gravam sempre NULL.
  variantName      String?  @map("variant_name")
  unitPrice        Decimal  @db.Decimal(10, 2) @map("unit_price")
  quantity         Int
  totalPrice       Decimal  @db.Decimal(10, 2) @map("total_price")
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product             @relation(fields: [productId], references: [id])
  modifiers OrderItemModifier[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ============================================================
// OrderItemModifier (com snapshots históricos)
// ============================================================

model OrderItemModifier {
  id           String   @id @default(uuid())
  orderItemId  String   @map("order_item_id")
  modifierId   String?  @map("modifier_id")
  // Snapshots históricos
  modifierName String   @map("modifier_name")
  price        Decimal  @db.Decimal(10, 2)
  quantity     Int      @default(1)
  createdAt    DateTime @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifier  Modifier? @relation(fields: [modifierId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@map("order_item_modifiers")
}

// ============================================================
// Payment
// ============================================================

model Payment {
  id                   String             @id @default(uuid())
  tableSessionId       String             @map("table_session_id")
  amount               Decimal            @db.Decimal(10, 2)
  method               PaymentMethod      @default(CASH)
  status               PaymentStatus      @default(PENDING)
  gatewayTransactionId String?            @map("gateway_transaction_id")
  gatewayResponse      Json?              @map("gateway_response")
  paidAt               DateTime?
  failedAt             DateTime?
  refundedAt           DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  tableSession TableSession @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)

  @@index([tableSessionId])
  @@map("payments")
}

// ============================================================
// AuditLog
// ============================================================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}
