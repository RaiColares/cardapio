# Ambiente da aplicação (development | test | production)
NODE_ENV=development

# Porta HTTP da API
PORT=4000

# Origem permitida pelo CORS (frontend em desenvolvimento)
CORS_ORIGIN=http://localhost:5173

# Conexão PostgreSQL (preenchida na Fase 2 — Banco de dados)
# Sem secrets reais. Substituir apenas em ambiente local.
DATABASE_URL=postgresql://user:password@localhost:5432/cardapio_digital

# Segurança JWT
# Trocar por valor longo e aleatório (ex.: gerar com `openssl rand -hex 48`)
JWT_SECRET=change-me-please-use-openssl-rand-hex-48
JWT_EXPIRES_IN=8h

# Seed do primeiro usuário ADMIN (somente desenvolvimento)
SEED_ADMIN_EMAIL=admin@balneario.dev
SEED_ADMIN_PASSWORD=admin12345
SEED_ADMIN_NAME=Administrador
